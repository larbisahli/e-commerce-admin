{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@pages/*": ["pages/*"],
      "@components/*": ["components/*"],
      "@contexts/*": ["contexts/*"],
      "@utils/*": ["utils/*"],
      "@hooks/*": ["hooks/*"],
      "@store/*": ["store/*"],
      "@lib/*": ["lib/*"],
      "@assets/*": ["assets/*"],
      "@containers/*": ["containers/*"],
      "@styles/*": ["styles/*"],
      "@middleware/*": ["middleware/*"],
      "@data/*": ["data/*"],
      "@graphql/*": ["graphql/*"],
      "@settings/*": ["settings/*"],
      "@ts-types/*": ["ts-types/*"],
      "@proto/*": ["proto/*"],
      "@services/*": ["services/*"],
      "@test-utils": ["__tests__/test-utils"]
    },
    "incremental": true
  },
  "include": ["next-env.d.ts", "additional.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
