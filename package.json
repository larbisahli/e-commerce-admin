    "start": "next start -p 3001",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{js,ts,css,tsx,json,md,yml}\"",
    "check-types": "tsc --pretty --noEmit",
    "check-format": "prettier --write \"**/*.{js,ts,scss,css,tsx,json,md,yml}\"",
